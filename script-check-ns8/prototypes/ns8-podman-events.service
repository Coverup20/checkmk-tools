[Unit]
Description=NS8 podman events watcher (feeds the CheckMK local check check_ns8_podman_events_local.py)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/monitor_podman_events_api.py
Restart=always
RestartSec=5
# Same token/state locations the scripts already default to; no overrides needed.

[Install]
WantedBy=multi-user.target
